# Supabase project the app talks to (public client keys — safe for the browser bundle, but keep .env out of git)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Optional: show a one-click "Continue with the demo account" button on the login page
VITE_DEMO_EMAIL=""
VITE_DEMO_PASSWORD=""
